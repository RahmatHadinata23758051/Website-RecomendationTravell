# Frontend Environment Variables
# Primary API endpoint for KelanaLampung NestJS Backend
VITE_API_BASE_URL=http://localhost:4000/api/v1
# Optional fallback alias (used only if VITE_API_BASE_URL is not provided)
# VITE_API_URL=http://localhost:4000/api/v1

# OpenWeatherMap API Key for live weather forecast widget on HomePage
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here
