datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  USER
  ADMIN
}

enum PlaceSubmissionStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  NEEDS_MORE_INFO
  DUPLICATE
}

enum PlaceSubmissionSource {
  USER
  OWNER_CLAIMED
  COMMUNITY
}

enum SubmissionVoteType {
  UPVOTE
  DOWNVOTE
  VERIFY
  FLAG_DUPLICATE
  FLAG_INACCURATE
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  fullName      String
  avatarUrl     String?
  bio           String?
  location      String?
  preferences   String[]       @default([])
  xp            Int            @default(0)
  role          UserRole       @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  favorites     UserFavorite[]
  itineraries   Itinerary[]
  reviews               Review[]
  activities            UserActivity[]
  submittedPlaces       PlaceSubmission[]       @relation("PlaceSubmissionSubmitter")
  moderatedSubmissions  PlaceSubmission[]       @relation("PlaceSubmissionModerator")
  submissionVotes       PlaceSubmissionVote[]
  submissionComments    PlaceSubmissionComment[]

  @@map("users")
}

model UserActivity {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  title     String
  subtitle  String?
  iconType  String?
  createdAt DateTime @default(now())

  @@map("user_activities")
}

model UserFavorite {
  id          String   @id @default(uuid())
  userId      String
  canonicalId String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, canonicalId])
  @@map("user_favorites")
}

model Itinerary {
  id          String   @id @default(uuid())
  userId      String
  title       String
  shareToken  String   @unique @default(uuid())
  daysJson    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("itineraries")
}

model Review {
  id             String   @id @default(uuid())
  userId         String
  canonicalId    String
  rating         Int
  reviewText     String
  sentimentLabel String
  sentimentScore Float
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([canonicalId])
  @@map("reviews")
}

model PlaceSubmission {
  id                   String                 @id @default(uuid())
  submitterId          String?
  submitter            User?                  @relation("PlaceSubmissionSubmitter", fields: [submitterId], references: [id], onDelete: SetNull)
  name                 String
  normalizedName       String
  category             String
  categoryTags         String[]               @default([])
  address              String
  cityRegency          String
  district             String?
  village              String?
  latitude             Float
  longitude            Float
  phone                String?
  website              String?
  description          String?                @db.Text
  openingHours         Json?
  priceMin             Int?
  priceMax             Int?
  currency             String                 @default("IDR")
  facilities           String[]               @default([])
  photos               Json?
  primaryPhotoUrl      String?
  ownershipProof       Json?
  isVerifiedOwner      Boolean                @default(false)
  status               PlaceSubmissionStatus  @default(PENDING)
  source               PlaceSubmissionSource  @default(USER)
  moderatorId          String?
  moderator            User?                  @relation("PlaceSubmissionModerator", fields: [moderatorId], references: [id], onDelete: SetNull)
  moderationNotes      String?                @db.Text
  rejectionReason      String?
  reviewedAt           DateTime?
  duplicateOfId        String?
  duplicateConfidence  Float?
  duplicateNotes       String?
  canonicalId          String?                @unique
  promotedAt           DateTime?
  promotionError       String?
  ipAddress            String?
  userAgent            String?
  submittedAt          DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  votes                PlaceSubmissionVote[]
  comments             PlaceSubmissionComment[]

  @@index([status])
  @@index([cityRegency, status])
  @@index([status, submittedAt])
  @@index([submitterId, status])
  @@index([normalizedName, cityRegency])
  @@map("place_submissions")
}

model PlaceSubmissionVote {
  id            String             @id @default(uuid())
  submissionId String
  submission   PlaceSubmission    @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  userId       String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  voteType     SubmissionVoteType
  createdAt    DateTime           @default(now())

  @@unique([submissionId, userId, voteType])
  @@index([submissionId, voteType])
  @@map("place_submission_votes")
}

model PlaceSubmissionComment {
  id           String          @id @default(uuid())
  submissionId String
  submission   PlaceSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  content      String          @db.Text
  isInternal   Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([submissionId, createdAt])
  @@map("place_submission_comments")
}
