# Server Configuration
PORT=4000
NODE_ENV=development

# CORS allowed origins (comma-separated)
# Local: http://127.0.0.1:5173,http://localhost:5173
# Production: use only the deployed frontend origin(s)
ALLOWED_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"

# Database PostgreSQL + PostGIS
DATABASE_URL="postgresql://postgres:password@localhost:5432/traveller_db?schema=public"

# Redis Cache & Session Store
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Secrets & Security
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"

# Microservice ML Engine Endpoint
ML_ENGINE_URL="http://localhost:8000"
ML_ENGINE_HEALTH_URL="http://localhost:8000/api/v1/health"
# Optional ML Catalog Webhook HMAC Secret (if configured, requests include x-ml-signature)
# ML_SYNC_HMAC_SECRET="your-ml-sync-hmac-secret-min-32-chars"

# 9Router LLM Gateway (OpenAI-compatible base URL, must end with /v1)
NINE_ROUTER_URL="http://localhost:20128/v1"
NINE_ROUTER_API_KEY="your-9router-api-key"
NINE_ROUTER_MODEL="gemini-lampung-pool"
# Standard OpenAI aliases (fallback when NINE_ROUTER_* not set)
OPENAI_BASE_URL="http://localhost:20128/v1"
OPENAI_API_KEY="your-9router-api-key"
OPENAI_MODEL="gemini-lampung-pool"
# Max wait for a completion in milliseconds (default 60000)
NINE_ROUTER_TIMEOUT_MS=60000

# RAG evaluation-only flags (normally unset; use only when calibrating/updating baseline)
# RAG_EVAL_CALIBRATE=1
# RAG_EVAL_WRITE_BASELINE=1
