# Server Configuration
PORT=4000
NODE_ENV=development

# Database PostgreSQL + PostGIS
DATABASE_URL="postgresql://postgres:password@localhost:5432/traveller_db?schema=public"

# Redis Cache & Session Store
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Secrets & Security
JWT_ACCESS_SECRET="super-secret-access-key-lampung-2026"
JWT_REFRESH_SECRET="super-secret-refresh-key-lampung-2026"

# Microservice ML Engine Endpoint
ML_ENGINE_URL="http://localhost:8000"

# 9Router LLM Gateway (OpenAI-compatible base URL, must end with /v1)
NINE_ROUTER_URL="http://localhost:20128/v1"
NINE_ROUTER_API_KEY="your-9router-api-key"
NINE_ROUTER_MODEL="gemini-lampung-pool"
# Optional standard OpenAI aliases (used when NINE_ROUTER_* is absent)
# OPENAI_BASE_URL="http://localhost:20128/v1"
# OPENAI_API_KEY="your-9router-api-key"
# OPENAI_MODEL="gemini-lampung-pool"
# Max wait for a completion in milliseconds (default 60000)
NINE_ROUTER_TIMEOUT_MS=60000
